# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）

# Greasy Fork webhook secret，在 https://greasyfork.org/zh-CN/users/webhook-info 生成
# 同时要填到 GitHub repo 的 Settings -> Webhooks -> Secret
GREASYFORK_WEBHOOK_SECRET=

# 非机密，便于用 gh api 修改/校验 webhook
GREASYFORK_WEBHOOK_URL=
GREASYFORK_WEBHOOK_ID=
GREASYFORK_USER_ID=
GREASYFORK_SCRIPT_ID=
